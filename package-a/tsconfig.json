/* try2/package-a/tsconfig.json */
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2020",                                  
    "module": "commonjs",                                
    "moduleResolution": "node",                     
    "allowJs": true,                                  
    "outDir": "dist",                                   
    "esModuleInterop": true,                             
    "forceConsistentCasingInFileNames": true,            
    "strict": true,                                      
    "skipLibCheck": true,
    "baseUrl": "./",                                  
    "paths": {
      "@/*": ["./src/*"]
    },                                      
  },
  "include": ["./*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    {"path": "../package-b"}
  ]
}
