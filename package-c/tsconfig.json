/* try2/package-c/tsconfig.json */
{
  "compilerOptions": {
    "composite": true,
    "target": "es2020",
    "module": "commonjs", // change to nodenext for ESM
    "types": ["node"],
    "declaration": true,
    // "declarationMap": true,
    // "sourceMap": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["./*"],
  "exclude": ["node_modules", "dist"]
}
